   begin
      case shift is
         when shift_1_byte => result_m128_view := ia32_pslldq (vec_m128_view, 1 * 8);
         when shift_2_bytes => result_m128_view := ia32_pslldq (vec_m128_view, 2 * 8);
         when shift_3_bytes => result_m128_view := ia32_pslldq (vec_m128_view, 3 * 8);
