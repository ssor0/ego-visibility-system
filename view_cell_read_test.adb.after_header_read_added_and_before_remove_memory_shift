         when shift_16_bytes => result_m128_view := ia32_pslldq (vec_m128_view, 16 * 8);
      end case;
      return result_vec;
   end pslldq;


   function por_128 (vector_1, vector_2 : in v4t) return v4t with inline is
      vec1_m128_view : sse_vt.m128i with address => vector_1'address;
