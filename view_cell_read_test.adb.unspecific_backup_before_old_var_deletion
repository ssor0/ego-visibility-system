   procedure nodes_to_txt is
      txt_file : file_type;


      plane_distance : unsigned_32;
      back_index : unsigned_16;

      pvs_offset : unsigned_32;

      node_index : positive := 1;
      leaf_index : positive := 1;

      vc : view_cell_union;

   begin
      --if dir.exists ("vc_nodes.txt")
      create (txt_file, out_file, "vc_nodes.txt");
      --reset (txt_file);
      put_line (txt_file, "header (num view cells and indices converted to 1 based)");
      put_line (txt_file, "num view cells:" & num_view_cells'image);
      put_line (txt_file, "worldMin xyz" & worldMin (0)'image &  worldMin (1)'image & worldMin (2)'image);
      put_line (txt_file, "worldMax xyz" & worldMax (0)'image &  worldMax (1)'image & worldMax (2)'image);
      new_line (txt_file, 2);


      for vc_index in 1 .. num_view_cells loop  --  if vc_union_test ever not 1based thiis has to be changed

         vc := view_cells (vc_index);

         if vc.leaf.isNonLeaf /= 0 then
         --  node

            put_line (txt_file, "node index:" & node_index'image);
            new_line (txt_file);

            put_line (txt_file, "plane axis: " & axis_str (vc.node.planeAxis).all);

            plane_distance := ui32 (vc.node.planeDistanceBottomBits) or
              shift_left (ui32 (vc.node.planeDistanceTopBits), 16);
            --  top bits must be casted before shift

            put_line (txt_file, "plane distance" & plane_distance'image);


            put_line (txt_file, "front index:" & vc.node.frontIndex'image);

            back_index := vc.node.backIndexLowerBits or
              shift_left (vc.node.backIndexTopBit, 12);  --  correct?

            put_line (txt_file, "back_index:" & back_index'image);

            new_line (txt_file, 2);

            node_index := node_index + 1;

         else
         --  leaf

            put_line (txt_file, "leaf index:" & leaf_index'image);

            pvs_offset := ui32 (vc.leaf.pvsOffsetLowerBits) or
              shift_left (ui32 (vc.leaf.pvsOffsetTopBits), 16);

            put_line (txt_file, "pvs offset:" & pvs_offset'image);
            --put_line (txt_file, );

            new_line (txt_file, 2);

            leaf_index := leaf_index + 1;
         end if;

      end loop;

      close (txt_file);
   end nodes_to_txt;




